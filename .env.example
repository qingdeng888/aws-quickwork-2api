# ─────────────────────────────────────────────────────────────
# aws-quickwork-2api · Docker Compose 环境变量
#
#   cp .env.example .env
#   vi .env          # 至少改 WEBUI_PASSWORD 和 API_KEYS
#   docker compose pull && docker compose up -d
#
# 这些变量由容器的 entrypoint 渲染进 /app/data/config.json，
# 每次 `docker compose up -d`（重建容器）都会重新应用。
# ─────────────────────────────────────────────────────────────

# ── 镜像与端口 ───────────────────────────────────────────────
# dev 分支：使用 Actions 为 dev 构建的镜像（所有 tag 带 -dev 后缀）。
# main 分支对应的是不带后缀的 :latest。
IMAGE=ghcr.io/qingdeng888/aws-quickwork-2api:latest-dev
CONTAINER_NAME=quickproxy
# 宿主机端口；容器内固定监听 8080
WEB_PORT=8080

# ── 管理界面 /admin ──────────────────────────────────────────
WEBUI_ENABLED=true
# 至少 8 位。留空时 /admin 返回 503（/v1 不受影响）
WEBUI_PASSWORD=change-this-password
# 可选：PBKDF2 哈希，用 `quickproxy passwd -password ...` 生成。
# 注意：WEBUI_PASSWORD 渲染时只写入 password_hash（明文不落盘）。
# 若 config.json 已有 password_hash（例如在 WebUI 中改过密码），默认不会被 env 覆盖；
# 需要强制以 env 为准时设置 WEBUI_PASSWORD_FORCE=1。
# WEBUI_PASSWORD_FORCE=0
# WEBUI_PASSWORD_HASH=
WEBUI_SESSION_TTL=12h
# 同一 IP 每 5 分钟允许的失败次数
WEBUI_MAX_ATTEMPTS=10
# 只有确定挂在会覆盖 X-Forwarded-For 的可信反代后面才设为 true
WEBUI_TRUST_PROXY=false

# ── 服务 ─────────────────────────────────────────────────────
# 容器内监听地址；改了它要同步改 compose 的端口映射和 healthcheck
ADDR=0.0.0.0:8080
# /v1 的本地 API key，逗号分隔；留空则不鉴权（只适合内网/本机）
API_KEYS=
MODELS=smart,fast,balanced,auto
DEFAULT_MODEL=smart
REQUEST_TIMEOUT=5m
# token 到期前多久开始自动刷新；后台每分钟检查一次，不依赖请求触发
REFRESH_BEFORE=10m
# 单次请求最多换几个账号重试
MAX_ATTEMPTS=3
TIMEZONE=Asia/Shanghai
LOCALE=zh-CN
# 空=上游默认；可选 off / low / medium / high
THINKING_EFFORT=
# 可选：指定 QuickWork 自定义 agent，用来替换内置提示词
# CHAT_AGENT_ID=

# ── 上游会话 ─────────────────────────────────────────────────
# true: 复用上游 thread，每轮只发新增消息（推荐，避开 64 KB 单帧上限）
SESSION_REUSE=true
SESSION_TTL=30m
KEEP_SESSIONS=false

# ── OAuth 默认值（在 /admin → 登录上游 里预填） ─────────────
OAUTH_PROVIDER=social
OAUTH_STAGE=prod
# 企业 discovery 的 region 前缀，social 留空
OAUTH_REGION=
OAUTH_CALLBACK_PORT=18080
OAUTH_TIMEOUT=1h

# ── 容器内登录提醒 ───────────────────────────────────────────
# 宿主机浏览器无法回调容器内的 127.0.0.1:18080，
# 所以「本机回调」模式在容器里不可用：请在 /admin 里用「手动回填 callback URL」。
